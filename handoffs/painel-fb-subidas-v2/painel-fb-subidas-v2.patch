+#!/usr/bin/env node
+// Coletor CloakUp → Subidas (Brandon 24/09/2026). SOMENTE LEITURA.
+//
+// Roda no Mac do Brandon, usando a sessão do CloakUp que JÁ está logada no Chrome dele.
+// Não faz login, não guarda senha, não clica em nada que altere o CloakUp: toda requisição
+// que não seja GET/HEAD/OPTIONS é BLOQUEADA antes de sair do navegador.
+//
+// Uso (Chrome aberto com a porta de depuração, sessão do CloakUp ativa):
+//   1) /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --remote-debugging-port=9222
+//   2) NODE_PATH=$(npm root -g) node tools/cloakup-coletor.mjs --cdp http://127.0.0.1:9222
+//      (ou --perfil "$HOME/Library/Application Support/Google/Chrome/Profile 1" com o Chrome fechado)
+// Saída: cloakup-coleta.json (formato que a Subidas importa em 🔗 CloakUp → 📥 Importar coleta).
+//   --dump   grava também cloakup-respostas-brutas.json para ajustar o extrator se o CloakUp mudar.
+//   --url    página de campanhas (padrão https://app.cloakup.me/campaigns)
+// Enviar para o painel é um passo SEPARADO e manual (não faz parte deste coletor).
+/* global getComputedStyle */
+import { createRequire } from 'node:module';
+import fs from 'node:fs';
+const require = createRequire(import.meta.url);
+const { chromium } = require('playwright');
+const extrator = require('./cloakup-extrator.cjs');
+
+const arg = (n, d) => { const i = process.argv.indexOf(n); return i > 0 ? process.argv[i + 1] : d; };
+const flag = n => process.argv.includes(n);
+const URL_CAMP = arg('--url', 'https://app.cloakup.me/campaigns');
+const saida = arg('--saida', 'cloakup-coleta.json');
+
+let browser, ctx;
+if (arg('--cdp')) { browser = await chromium.connectOverCDP(arg('--cdp')); ctx = browser.contexts()[0] || await browser.newContext(); }
+else if (arg('--perfil')) { ctx = await chromium.launchPersistentContext(arg('--perfil'), { headless: false, channel: 'chrome' }); }
+else { console.error('Informe --cdp http://127.0.0.1:9222 ou --perfil <pasta do perfil do Chrome>.'); process.exit(2); }
+
+const page = await ctx.newPage();
+const bloqueadas = [];
+await page.route('**/*', rota => {
+  const m = rota.request().method();
+  if (m === 'GET' || m === 'HEAD' || m === 'OPTIONS') return rota.continue();
+  bloqueadas.push(m + ' ' + rota.request().url());
+  return rota.abort();
+});
+const respostas = [], brutas = [];
+page.on('response', async r => {
+  try {
+    if (!/json/i.test(r.headers()['content-type'] || '')) return;
+    const j = await r.json(); respostas.push(j); if (flag('--dump')) brutas.push({ url: r.url(), json: j });
+  } catch { /* resposta sem corpo JSON legível */ }
+});
+await page.goto(URL_CAMP, { waitUntil: 'networkidle', timeout: 60000 });
+if (/login|entrar|signin/i.test(page.url())) { console.error('A sessão do CloakUp não está logada neste navegador. Entre manualmente e rode de novo.'); await page.close(); process.exit(3); }
+// paginação por rolagem: o app carrega mais campanhas ao descer
+for (let i = 0; i < 12; i++) { await page.mouse.wheel(0, 4000); await page.waitForTimeout(700); }
+await page.waitForLoadState('networkidle').catch(() => {});
+// bolinha verde (sinal auxiliar): nomes com o indicador visual ativo na lista
+const verdes = await page.$$eval('*', els => els.filter(e => { const c = getComputedStyle(e).backgroundColor; return e.childElementCount === 0 && e.offsetWidth > 4 && e.offsetWidth < 16 && /rgb\((3[0-9]|[0-9]{1,2}), (1[6-9][0-9]|2[0-4][0-9]), /.test(c); }).map(e => (e.closest('tr,li,[role=row],a,div') || e).textContent.trim().slice(0, 160))).catch(() => []);
+const coleta = extrator.consolida(respostas);
+coleta.verdesNaTela = verdes.length;
+coleta.campanhas.forEach(c => { if (!c.ativa && verdes.some(t => t.includes(c.n.slice(0, 40)))) c.ativaVisual = true; });
+fs.writeFileSync(saida, JSON.stringify(coleta, null, 2));
+if (flag('--dump')) fs.writeFileSync('cloakup-respostas-brutas.json', JSON.stringify(brutas, null, 2));
+console.log(`CloakUp: ${coleta.campanhas.length} campanhas · ${coleta.campanhas.filter(c => c.ativa || c.ativaVisual).length} ativas · sem código ${coleta.avisos.semCodigo} · sem parâmetro ${coleta.avisos.semParam}`);
+console.log(`Gravado em ${saida}. Requisições de escrita bloqueadas: ${bloqueadas.length}`);
+await page.close();
+if (browser) await browser.close().catch(() => {}); else await ctx.close();
diff --git a/tools/cloakup-extrator.cjs b/tools/cloakup-extrator.cjs
new file mode 100644
index 0000000..7deed7e
--- /dev/null
+++ b/tools/cloakup-extrator.cjs
@@ -0,0 +1,76 @@
+'use strict';
+// Extrai as campanhas do CloakUp a partir das respostas JSON que o próprio app carrega
+// (app.cloakup.me). Função pura: recebe objetos já lidos e devolve o formato que a Subidas
+// consome em pref2 'cloakup': {em, fonte, campanhas:[{a,n,s,o,d,l,p,ativa,id}]}.
+//   a = código do link do cloaker (ck.dominio/<a>)   n = nome da campanha
+//   s = página segura (white page)                    o = páginas de oferta
+//   d = domínio                                       l = link do cloaker
+//   p = parâmetro exclusivo (ex.: tQuvxQqg7d=q4Leb6wXrx)   ativa = status ativo (bolinha verde)
+// Nomes de campo conhecidos (coletor de 04/09): white_page, offer_page_url. Os demais são
+// procurados por padrão de valor, e o que não for encontrado fica vazio (nunca inventado).
+const PARAM_RE=/^[A-Za-z0-9_]{6,20}=[A-Za-z0-9_-]{6,30}$/;
+const LINK_RE=/^https?:\/\/[^/\s]+\/([a-z0-9]{6,14})\/?$/i;
+const URL_RE=/^https?:\/\/[^\s]+$/i;
+function strings(obj,depth,out,path){
+  if(depth>4||obj==null)return out;
+  if(typeof obj==='string'){out.push({path,v:obj.trim()});return out;}
+  if(Array.isArray(obj)){obj.slice(0,40).forEach((x,i)=>strings(x,depth+1,out,path+'['+i+']'));return out;}
+  if(typeof obj==='object')Object.keys(obj).slice(0,120).forEach(k=>strings(obj[k],depth+1,out,path?path+'.'+k:k));
+  return out;
+}
+const pega=(o,nomes)=>{for(const n of nomes){const v=n.split('.').reduce((a,k)=>a==null?a:a[k],o);if(v!=null&&v!=='')return v;}return null;};
+// so texto/numero/booleano: objeto aninhado (ex.: domain:{name}) e lido pelo caminho com ponto
+const pegaValor=(o,nomes)=>{for(const n of nomes){const v=n.split('.').reduce((a,k)=>a==null?a:a[k],o);if(v!=null&&v!==''&&typeof v!=='object')return v;}return null;};
+function pareceCampanha(o){
+  if(!o||typeof o!=='object'||Array.isArray(o))return false;
+  const ks=Object.keys(o).join(' ').toLowerCase();
+  return /(white_?page|safe_?page|offer_?page|money_?page)/.test(ks)&&/(name|nome|title)/.test(ks);
+}
+function campanhasDe(json,acc){
+  acc=acc||[];
+  const visita=(x,d)=>{
+    if(d>6||x==null||typeof x!=='object')return;
+    if(Array.isArray(x)){x.forEach(y=>visita(y,d+1));return;}
+    if(pareceCampanha(x))acc.push(x);
+    Object.keys(x).forEach(k=>{if(x[k]&&typeof x[k]==='object')visita(x[k],d+1);});
+  };
+  visita(json,0);
+  return acc;
+}
+function ativaDe(o){
+  const v=pega(o,['active','is_active','enabled','status','state','ativo']);
+  if(typeof v==='boolean')return v;
+  if(typeof v==='number')return v===1;
+  if(typeof v==='string')return /^(active|ativo|ativa|enabled|on|running|1|true)$/i.test(v.trim());
+  return false;
+}
+function normaliza(o){
+  const n=String(pega(o,['name','nome','title','campaign_name'])||'').trim();
+  const s=String(pega(o,['white_page','whitePage','safe_page','safePage','white_page_url'])||'').trim();
+  let ofertas=pega(o,['offer_page_url','offerPageUrl','offer_pages','offer_page','money_page','offers']);
+  ofertas=(Array.isArray(ofertas)?ofertas:[ofertas]).map(x=>typeof x==='object'&&x?(x.url||x.offer_page_url||''):x).map(x=>String(x||'').trim()).filter(x=>URL_RE.test(x));
+  const tudo=strings(o,0,[],'');
+  const link=(tudo.find(x=>LINK_RE.test(x.v)&&!/white|offer|page/i.test(x.path))||{}).v||'';
+  let a=String(pega(o,['slug','hash','code','codigo','short_code','shortCode'])||'').trim();
+  if(!/^[a-z0-9]{6,14}$/i.test(a))a=link?LINK_RE.exec(link)[1]:'';
+  let d=String(pegaValor(o,['domain','dominio','domain_name','domain.name','domain.domain','domain.host'])||'').trim().toLowerCase().replace(/^https?:\/\//,'').replace(/\/.*$/,'');
+  if(!d&&ofertas[0])d=ofertas[0].replace(/^https?:\/\//,'').replace(/\/.*$/,'').toLowerCase();
+  const p=(tudo.find(x=>PARAM_RE.test(x.v)&&!/utm_|sub\d/i.test(x.v))||{}).v||'';
+  const id=String(pega(o,['id','uuid','_id'])||'');
+  return {id,a,n,s,o:ofertas,d,l:link,p,ativa:ativaDe(o)};
+}
+function consolida(respostas,agora){
+  const vistos=new Map();
+  (respostas||[]).forEach(j=>campanhasDe(j).forEach(o=>{
+    const c=normaliza(o);if(!c.n)return;
+    const k=c.id||c.a||c.n;const ant=vistos.get(k);
+    // resposta parcial (outra tela) nao apaga o que ja foi lido; ativa vale se QUALQUER leitura disse ativa
+    const junto=ant?Object.assign({},ant,Object.fromEntries(Object.entries(c).filter(([key,v])=>key!=='ativa'&&v!==''&&!(Array.isArray(v)&&!v.length)))):c;
+    if(ant)junto.ativa=!!(ant.ativa||c.ativa);
+    vistos.set(k,junto);
+  }));
+  const campanhas=[...vistos.values()].sort((x,y)=>x.n.localeCompare(y.n));
+  const semCodigo=campanhas.filter(c=>!c.a).length,semParam=campanhas.filter(c=>!c.p).length;
+  return {em:agora||new Date().toISOString(),fonte:'app.cloakup.me (somente leitura)',campanhas,avisos:{semCodigo,semParam}};
+}
+module.exports={campanhasDe,normaliza,consolida,PARAM_RE,LINK_RE};

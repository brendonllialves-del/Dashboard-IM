+
+test('single VSL: counts are the VSL itself and rates come from the sums',()=>{
+  const r=AB.consolida([{vis:1000,visU:900,plays:500,playsU:450,over:100,under:300,cliques:40,engaj:40,porVsl:{A:vslA}}]);
+  assert.equal(r.ab,false);assert.equal(r.nVsl,1);assert.deepEqual(r.vsls,['A']);
+  assert.equal(r.playRate,50);assert.equal(r.retPitch,25);assert.equal(r.audPitch,100);assert.equal(r.cliquesBotao,40);assert.equal(r.engaj,40);
+  assert.equal(r.perdaPlay,50);assert.equal(r.perdaClique,60);
+});
+
+test('A/B group: sums for counts, arithmetic mean for Play Rate / Engajamento / Ret. Pitch, sum for audience',()=>{
+  const dia1={vis:1000,visU:900,plays:500,playsU:450,over:100,under:300,cliques:40,engaj:40,porVsl:{A:vslA}};
+  const dia2={vis:200,visU:180,plays:150,playsU:135,over:60,under:40,cliques:12,engaj:60,porVsl:{B:vslB}};
+  const r=AB.consolida([dia1,dia2]);
+  assert.equal(r.ab,true);assert.deepEqual(r.vsls,['A','B']);
+  assert.equal(r.vis,1200);assert.equal(r.visU,1080);assert.equal(r.plays,650);assert.equal(r.playsU,585);assert.equal(r.cliquesBotao,52);
+  assert.equal(r.playRate,62.5);            // (50 + 75) / 2, not 585/1080
+  assert.equal(r.retPitch,42.5);            // (25 + 60) / 2, not 160/500
+  assert.equal(r.engaj,50);                 // (40 + 60) / 2
+  assert.equal(r.audPitch,160);assert.match(r.calc.audPitch,/soma de over_pitch/);
+  assert.match(r.calc.playRate,/média aritmética de 2/);
+  assert.equal(r.perdaPlay,45.83);assert.equal(r.perdaClique,67.5);
+});
+
+test('same VSL across several days is one VSL, never an A/B group',()=>{
+  const r=AB.consolida([{vis:10,plays:5,over:1,under:1,porVsl:{A:{vis:10,plays:5,over:1,under:1}}},{vis:30,plays:9,over:2,under:2,porVsl:{A:{vis:30,plays:9,over:2,under:2}}}]);
+  assert.equal(r.ab,false);assert.equal(r.nVsl,1);assert.equal(r.playRate,35);assert.equal(r.retPitch,50);
+});
+

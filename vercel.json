{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/teste-ads", "destination": "/teste-ads/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/analise-fb", "destination": "/analise-fb/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
